{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "segment-rule-dsl.schema.json",
  "title": "Segment Rule DSL",
  "description": "Segment rule json schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["information", "dslRule"],
  "properties": {
    "version": {
      "type": "string",
      "default": "segment_version",
      "description": "mô tả segment version"
    },
    "information": { "$ref": "#/definitions/information" },
    "dslRule": { "$ref": "#/definitions/dslRule" },
    "settings": { "$ref": "#/definitions/settings" },
    "outputConfig": { "$ref": "#/definitions/outputConfig" }
  },

  "definitions": {
    "segmentKey": {
      "type": "string",
      "pattern": "^([A-Za-z0-9_]+)?$",
      "description": "Key của segment/group: chữ, số, gạch dưới (vd 'price_sensitive_has_high_engagement', 'AVN_Engager', '4_Activity'). Cho phép chuỗi rỗng."
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Độ ưu tiên"
    },
    "color": {
      "type": "string",
      "pattern": "^(#?([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6}))?$",
      "default": "",
      "description": "Mã màu hex hiển thị. Cho phép chuỗi rỗng."
    },

    "information": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority"],
      "description": "Thông tin hiển thị & định danh segment. Phải có ít nhất assignSegment hoặc name.",
      "properties": {
        "assignSegment": {
          "$ref": "#/definitions/segmentKey",
          "description": "Key segment sẽ gán cho profile."
        },
        "assignGroup": {
          "$ref": "#/definitions/segmentKey",
          "description": "Group chứa segment. Có thể rỗng."
        },
        "name": {
          "$ref": "#/definitions/segmentKey",
          "description": "Tên segment (thường trùng assignSegment)."
        },
        "category": {
          "$ref": "#/definitions/segmentKey",
          "description": "Category (thường trùng assignGroup)."
        },
        "priority": { "$ref": "#/definitions/priority" },
        "color": { "$ref": "#/definitions/color" }
      },
      "anyOf": [
        { "required": ["assignSegment"], "properties": { "assignSegment": { "minLength": 1 } } },
        { "required": ["name"], "properties": { "name": { "minLength": 1 } } }
      ]
    },

    "dslRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "status", "windowTime", "sort"],
      "properties": {
        "rule": {
          "$ref": "#/definitions/filterNode",
          "description": "Điều kiện gán segment. Có thể là 1 leaf đơn hoặc 1 nhóm and/or lồng nhau."
        },
        "status": {
          "type": "string",
          "enum": ["Active", "Inactive"],
          "default": "Active",
          "description": "Trạng thái rule."
        },
        "windowTime": { "$ref": "#/definitions/windowTime" },
        "sort": {
          "type": "array",
          "default": [],
          "description": "Thứ tự xử lý profile.",
          "items": { "$ref": "#/definitions/sortItem" }
        },
        "assignSegment": {
          "$ref": "#/definitions/segmentKey",
          "description": "Mirror của information.assignSegment. Có thể rỗng."
        },
        "assignGroup": {
          "$ref": "#/definitions/segmentKey",
          "description": "Mirror của information.assignGroup. Có thể rỗng."
        },
        "name": {
          "$ref": "#/definitions/segmentKey",
          "description": "Mirror của information.name. Có thể rỗng."
        },
        "category": {
          "$ref": "#/definitions/segmentKey",
          "description": "Mirror của information.category. Có thể rỗng."
        },
        "priority": { "$ref": "#/definitions/priority" },
        "forceUpdate": {
          "type": "boolean",
          "default": false,
          "description": "true: ghi đè segment hiện có của profile kể cả khi không đổi."
        }
      }
    },

    "windowTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "description": "Khoảng thời gian quét profile",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Hour", "Day", "Week", "Month"],
          "default": "Day"
        },
        "value": {
          "type": "integer",
          "minimum": 1
        }
      }
    },

    "sortItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "order"],
      "properties": {
        "field": { "$ref": "#/definitions/profileField" },
        "order": { "type": "string", "enum": ["asc", "desc"], "default": "desc" }
      }
    },

    "profileField": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)?$",
      "description": "Field của customer profile. Cột thường: 'coreTagIds', 'gender', 'lastTouchedAt', 'userSegmentKeys'... Field trong Map dùng DOTTED PATH (khác Tag Rule DSL): 'attributes.<key>' (String), 'attributeInts.<key>', 'attributeBooleans.<key>', 'attributeDoubles.<key>', 'attributeDates.<key>'.",
      "examples": ["coreTagIds", "gender", "attributes.ownerRole", "attributeInts.total_events_after_engaged", "attributeBooleans.is_engager"]
    },

    "filterNode": {
      "oneOf": [
        { "$ref": "#/definitions/filterGroup" },
        { "$ref": "#/definitions/filterLeaf" }
      ]
    },

    "filterGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "children"],
      "properties": {
        "type": { "type": "string", "enum": ["and", "or"] },
        "children": {
          "type": "array",
          "minItems": 1,
          "description": "Có thể lồng nhóm (vd nhóm 'or' trong nhóm 'and').",
          "items": { "$ref": "#/definitions/filterNode" }
        }
      }
    },

    "filterLeaf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "values"],
      "properties": {
        "field": { "$ref": "#/definitions/profileField" },
        "operator": {
          "type": "string",
          "enum": [
            "equals", "not_equals", "in", "not_in",
            "like", "not_like", "is_null", "is_not_null",
            "gt", "gte", "lt", "lte",
            "contains_any", "contains_all", "containsAny", "containsAll",
            "exist", "not_exist",
            "gte_relative_day", "lte_relative_day"
          ],
          "description": "Ưu tiên snake_case."
        },
        "values": {
          "type": "array",
          "items": { "type": ["string", "number", "boolean"] }
        },
        "dataType": {
          "type": "string",
          "enum": ["String", "Int", "Long", "Double", "Boolean", "Date"],
          "description": "Kiểu dữ liệu của field (tùy chọn). Khuyến nghị khai báo khi field là mảng hoặc Map."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "operator": { "enum": ["is_null", "is_not_null", "exist", "not_exist"] } } },
          "then": {
            "properties": {
              "values": {
                "maxItems": 1,
                "items": { "const": "" },
                "description": "Không cần giá trị: dùng [] hoặc [\"\"]."
              }
            }
          }
        },
        {
          "if": { "properties": { "operator": { "enum": ["equals", "not_equals"] } } },
          "then": {
            "properties": {
              "values": {
                "minItems": 1, "maxItems": 1,
                "items": { "type": ["string", "number", "boolean"] },
                "description": "1 giá trị. Field attributeBooleans.* dùng boolean (vd [true]); attributeInts.* chấp nhận số hoặc chuỗi số (vd [\"4\"]). Dùng [\"\"] để so khớp chuỗi rỗng."
              }
            }
          }
        },
        {
          "if": { "properties": { "operator": { "enum": ["in", "not_in"] } } },
          "then": {
            "properties": {
              "values": { "minItems": 1, "items": { "type": ["string", "number"] } }
            }
          }
        },
        {
          "if": { "properties": { "operator": { "enum": ["contains_any", "contains_all", "containsAny", "containsAll"] } } },
          "then": {
            "properties": {
              "values": {
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 },
                "description": "Dùng cho field mảng (coreTagIds, userSegmentKeys). contains_any: chứa ít nhất 1; contains_all: chứa tất cả."
              }
            }
          }
        },
        {
          "if": { "properties": { "operator": { "enum": ["like", "not_like"] } } },
          "then": {
            "properties": {
              "values": {
                "minItems": 1, "maxItems": 1,
                "items": { "type": "string", "pattern": "%" },
                "description": "Pattern có wildcard %, vd '%IELTS%'."
              }
            }
          }
        },
        {
          "if": { "properties": { "operator": { "enum": ["gt", "gte", "lt", "lte"] } } },
          "then": {
            "properties": {
              "values": {
                "minItems": 1, "maxItems": 1,
                "items": { "type": ["number", "string"] },
                "description": "1 giá trị số hoặc chuỗi số / ISO datetime."
              }
            }
          }
        },
        {
          "if": { "properties": { "operator": { "enum": ["gte_relative_day", "lte_relative_day"] } } },
          "then": {
            "properties": {
              "values": {
                "minItems": 1, "maxItems": 1,
                "items": { "type": "integer" },
                "description": "Số ngày tương đối, vd [30]."
              }
            }
          }
        }
      ]
    },

    "settings": {
      "type": "object",
      "additionalProperties": false,
      "description": "Cấu hình thực thi segment.",
      "properties": {
        "enabledAssignSegment": { "type": "boolean", "default": true, "description": "Bật gán segment." },
        "enableCleanup": { "type": "boolean", "default": true, "description": "Gỡ segment khỏi profile không còn thỏa rule." },
        "cleanupDelay": { "type": "integer", "minimum": 0, "default": 3000, "description": "Độ trễ cleanup (ms)." },
        "enableOutput": { "type": "boolean", "default": true, "description": "Bật đẩy kết quả theo outputConfig." },
        "enabledDebugAssignSegment": { "type": "boolean", "default": false },
        "enableDebugCleanup": { "type": "boolean", "default": false },
        "enableDebugOutput": { "type": "boolean", "default": false }
      }
    },

    "outputConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filter", "storage"],
      "description": "Cấu hình đẩy profile thuộc segment ra hệ thống đích. Chỉ cần khi settings.enableOutput = true.",
      "properties": {
        "filter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy"],
          "properties": {
            "strategy": {
              "type": "object",
              "additionalProperties": false,
              "required": ["strategyType"],
              "properties": {
                "strategyType": {
                  "type": "string",
                  "enum": ["Only_Rule_Version"],
                  "default": "Only_Rule_Version"
                }
              }
            }
          }
        },
        "storage": { "$ref": "#/definitions/storage" }
      }
    },

    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storageType", "model", "mapping"],
      "properties": {
        "storageType": { "type": "string", "enum": ["Event_Bus"], "default": "Event_Bus" },
        "model": {
          "type": "string",
          "pattern": "^M-[A-Z0-9]{5}-O-[A-Z0-9]{5}-M$",
          "description": "Mã model đích, vd 'M-JDVD0-O-BMBP6-M'."
        },
        "eventbus": { "type": "object", "default": {}, "description": "Cấu hình event bus. Mặc định {}." },
        "mapping": { "$ref": "#/definitions/mapping" },
        "usePangoCDP": { "type": "boolean", "default": true }
      }
    },

    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "fieldMapping"],
      "properties": {
        "version": { "type": "string", "default": "1" },
        "fieldMapping": {
          "type": "object",
          "additionalProperties": false,
          "required": ["directFields"],
          "properties": {
            "directFields": {
              "type": "array",
              "minItems": 1,
              "description": "Map field profile sang field chuẩn của model đích. Thường có mainPhone → phone (required: true).",
              "items": { "$ref": "#/definitions/directFieldMap" }
            },
            "customFields": {
              "type": "array",
              "default": [],
              "items": { "$ref": "#/definitions/customFieldMap" }
            }
          }
        },
        "postProcessing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "defaults": {
              "type": "object",
              "additionalProperties": false,
              "required": ["recordStatus", "datasource"],
              "properties": {
                "recordStatus": { "type": "string", "enum": ["Active", "Inactive"], "default": "Active" },
                "datasource": {
                  "type": "string",
                  "pattern": "^PConnext_Segment_[a-f0-9]{32}$",
                  "description": "Vd 'PConnext_Segment_504b01de4dbc2847ec40c97d0c8e9466'."
                }
              }
            }
          }
        }
      }
    },

    "directFieldMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "dest", "required"],
      "properties": {
        "source": { "$ref": "#/definitions/profileField" },
        "dest": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "examples": ["phone", "email"]
        },
        "required": { "type": "boolean", "default": false }
      }
    },

    "customFieldMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "dest", "required"],
      "properties": {
        "source": { "$ref": "#/definitions/profileField" },
        "dest": {
          "type": "string",
          "pattern": "^customField(Timestamp|List|Boolean|Long|Double)?[0-9]{2}$",
          "description": "Slot custom field theo kiểu: customFieldNN (string), customFieldTimestampNN (date), customFieldListNN (mảng), customFieldBooleanNN (boolean)...",
          "examples": ["customField01", "customFieldTimestamp01", "customFieldList01", "customFieldBoolean01"]
        },
        "required": { "type": "boolean", "default": false }
      }
    }
  }
}
